# A API lê variáveis a partir do ambiente do processo.
# Prefira copiar o arquivo da raiz do monorepo:
#   cp ../.env.example ../.env
#
# Espelho das variáveis usadas pelo backend:

BIBLELINGO_ENV=development
BIBLELINGO_SECRET_KEY=dev-secret-change-me-in-production
BIBLELINGO_TOKEN_HOURS=72
BIBLELINGO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BIBLELINGO_DB_PATH=data/biblelingo.db
